# Local development. Copy to .env.local inside web/.
DATABASE_URL=file:./data/workforce.sqlite
APP_URL=http://localhost:3000
# Public demo booking: paste a Calendly event-type URL, for example https://calendly.com/your-team/demo.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/contact-theaipods/30min
# Optional additional admin: grant access after this work email is registered and verified.
INITIAL_ADMIN_EMAIL=
COOKIE_SECURE=false
# Signup and recovery require Resend in BOTH local and production.
MAIL_MODE=resend
RESEND_API_KEY=
RESEND_FROM=
CONTACT_LEADS_TO=contact@theaipods.com

# Provider contract: docs/PROVIDERS.md. Set FORMAT=responses for a direct
# https://api.openai.com/v1/responses endpoint, or gateway for {text} adapters.
CHAT_MODEL_URL=https://api.openai.com/v1/responses
CHAT_MODEL_KEY=
CHAT_MODEL_NAME=
CHAT_MODEL_FORMAT=responses
CODE_MODEL_URL=https://api.openai.com/v1/responses
CODE_MODEL_KEY=
CODE_MODEL_NAME=
CODE_MODEL_FORMAT=responses
# For Claude Sonnet via AWS Bedrock instead:
# CODE_MODEL_FORMAT=bedrock
# CODE_MODEL_NAME=<model ID or inference profile ARN from your Bedrock console>
# AWS_REGION=<region where your model is enabled>
# AWS_PROFILE=<your local AWS CLI profile> (or use AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, plus AWS_SESSION_TOKEN for temporary credentials)
# BEDROCK_USE_DEFAULT_CREDENTIALS=true enables the SDK's role credential chain.
# CODE_BEDROCK_THINKING=adaptive (Sonnet 4.6+) or extended (Sonnet 4/4.5)
# CODE_REASONING_XHIGH=high (explicit mapping for Sonnet without xhigh support)
# Optional explicit reasoning mapping for models that do not support xhigh:
# CHAT_REASONING_XHIGH=high
# CODE_REASONING_XHIGH=high
# Use omit only for a model with no reasoning-effort parameter.
# Optional output/reasoning token budget override per call (1024–128000).
# CHAT_MAX_OUTPUT_TOKENS=32000
# CODE_MAX_OUTPUT_TOKENS=32000
# Profile MCP bearer-token encryption: generate once with
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_SECRET_KEY=
# Additional personal/disposable domains to reject (comma-separated).
BLOCKED_EMAIL_DOMAINS=
EMBEDDING_MODEL_URL=
EMBEDDING_MODEL_KEY=
EMBEDDING_MODEL_NAME=
IMAGE_MODEL_URL=
IMAGE_MODEL_KEY=
IMAGE_MODEL_NAME=
VIDEO_MODEL_URL=
VIDEO_MODEL_KEY=
VIDEO_MODEL_NAME=
AUDIO_MODEL_URL=
AUDIO_MODEL_KEY=
AUDIO_MODEL_NAME=
VISION_MODEL_URL=
VISION_MODEL_KEY=
VISION_MODEL_NAME=
MAX_MODEL_CALLS_PER_POD=100

# Optional public-company research. Automatic falls back to free HTTP + Playwright.
FIRECRAWL_API_KEY=
# Google Custom Search is for existing eligible customers only (see docs/RESEARCH.md).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Provider switch: nvidia | azure | bedrock | legacy. Only selected provider credentials are used.
# NVIDIA endpoints are for free prototyping, subject to account limits.
# VISION is reserved; text embeddings power saved company-knowledge retrieval.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_CODE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_CHAT_DEPLOYMENT=
AZURE_CODE_DEPLOYMENT=
AZURE_EMBEDDING_DEPLOYMENT=
AWS_REGION=
AWS_BEDROCK_CHAT_MODEL=
AWS_BEDROCK_CODE_MODEL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
BEDROCK_USE_DEFAULT_CREDENTIALS=false

# Onboarding fallback providers. Hugging Face requires purchased/subscription credits.
ONBOARDING_AI_PROVIDERS=primary,groq,openrouter,huggingface
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
HUGGINGFACE_ENABLED=false
HUGGINGFACE_API_KEY=
HUGGINGFACE_CHAT_MODEL=openai/gpt-oss-120b:cheapest
