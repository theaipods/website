# Local development. Copy to .env.local inside web/.
DATABASE_URL=file:./data/workforce.sqlite
APP_URL=http://localhost:3000
# Public demo booking: paste a Calendly event-type URL, for example https://calendly.com/your-team/demo.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/contact-theaipods/30min
ENABLE_DEMO_ADMIN=true
# Production bootstrap: register and verify this account to grant the first admin role.
INITIAL_ADMIN_EMAIL=
COOKIE_SECURE=false
# Without a Resend key, development codes appear ONLY in the server terminal.
MAIL_MODE=console
RESEND_API_KEY=
RESEND_FROM=

# Provider-neutral gateway contract: docs/PROVIDERS.md.
# A vendor API URL generally needs an adapter; it is not this contract.
CHAT_MODEL_URL=
CHAT_MODEL_KEY=
CHAT_MODEL_NAME=
CODE_MODEL_URL=
CODE_MODEL_KEY=
CODE_MODEL_NAME=
EMBEDDING_MODEL_URL=
EMBEDDING_MODEL_KEY=
EMBEDDING_MODEL_NAME=
IMAGE_MODEL_URL=
IMAGE_MODEL_KEY=
IMAGE_MODEL_NAME=
VIDEO_MODEL_URL=
VIDEO_MODEL_KEY=
VIDEO_MODEL_NAME=
AUDIO_MODEL_URL=
AUDIO_MODEL_KEY=
AUDIO_MODEL_NAME=
VISION_MODEL_URL=
VISION_MODEL_KEY=
VISION_MODEL_NAME=
MAX_MODEL_CALLS_PER_POD=100

# Optional public-company research. Automatic falls back to free HTTP + Playwright.
FIRECRAWL_API_KEY=
# Google Custom Search is for existing eligible customers only (see docs/RESEARCH.md).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
